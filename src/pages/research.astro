---
import BaseLayout from "../layouts/BaseLayout.astro";
import { research, posters } from "../data";
---

<BaseLayout
  title="Research"
  description="Research and publications by Aawaz Pokhrel."
  wide
>
  <header class="page-header">
    <h1>Research</h1>
    <p>Publications, preprints, and conference posters in pharmaceutical imaging, AI, and biophysics.</p>
  </header>
  <section>
    <div class="grid stack">
      {
        research.map((item) =>
          item.url ? (
            <a
              class="card"
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <p class="card-meta">
                {item.venue} · {item.year}
              </p>
              <h3>{item.title}</h3>
              {item.authors && <p class="card-meta">{item.authors}</p>}
              <p class="muted">{item.summary}</p>
            </a>
          ) : (
            <article class="card">
              <p class="card-meta">
                {item.venue} · {item.year}
              </p>
              <h3>{item.title}</h3>
              {item.authors && <p class="card-meta">{item.authors}</p>}
              <p class="muted">{item.summary}</p>
            </article>
          )
        )
      }
    </div>
  </section>
  <section class="posters">
    <h2>Conference posters</h2>
    <div class="grid stack">
      {
        posters.map((p) => (
          <article class="card">
            <p class="card-meta">{p.event}</p>
            <h3>{p.title}</h3>
            <p class="card-meta">{p.role}</p>
            <p class="muted">{p.summary}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding: var(--space-12) 0 var(--space-8);
  }
  .page-header h1 {
    font-size: clamp(2rem, 5vw, 2.6rem);
    margin-bottom: var(--space-2);
  }
  .page-header p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 44rem;
  }
  section {
    border-top: none;
    padding-top: 0;
  }
  .posters {
    margin-top: var(--space-12);
  }
  .posters h2 {
    font-size: 1.4rem;
    margin-bottom: var(--space-4);
  }
</style>
