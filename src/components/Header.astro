---
import { nav, site } from "../config";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href.split("#")[0]);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">{site.name}</a>

    <nav class="nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: isActive(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.linkedin}
        class="nav-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>
    </nav>

    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="Toggle color theme"
    >
      <span class="visually-hidden">Toggle theme</span>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"></path>
      </svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 60px;
    max-width: 68rem;
  }
  .brand {
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .brand:hover {
    text-decoration: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    flex-wrap: wrap;
  }
  .nav-link {
    color: var(--text-muted);
    font-size: 0.95rem;
    padding: var(--space-1) var(--space-2);
    border-radius: 8px;
  }
  .nav-link:hover {
    color: var(--text);
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--text);
    font-weight: 600;
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition: border-color var(--transition);
  }
  .theme-toggle:hover {
    border-color: var(--accent);
  }
  .icon-moon {
    display: none;
  }
  :root[data-theme="dark"] .icon-sun {
    display: none;
  }
  :root[data-theme="dark"] .icon-moon {
    display: block;
  }
  @media (max-width: 540px) {
    .brand {
      font-size: 0.95rem;
    }
    .nav-link {
      font-size: 0.85rem;
    }
  }
</style>
